# Kaggle Benchmarks environment.
#
# Do NOT edit .env by hand. `kaggle b auth -y` overwrites it with fresh model
# proxy credentials, and they expire about an hour after they are issued.
#
#   kaggle b init -y     first-time setup: scaffolds .env and local config
#   kaggle b auth -y     refresh credentials only
#
# scripts/kbench-env.sh wraps both: it refreshes when needed and exports
# everything into the shell. Use it rather than sourcing .env directly.
#
#   source scripts/kbench-env.sh
#
# ---------------------------------------------------------------------------
# Generated by `kaggle b auth -y` (these three only):
#
#   MODEL_PROXY_URL=https://mp-staging.kaggle.net/models
#   MODEL_PROXY_API_KEY=<issued per session>
#   MODEL_PROXY_EXPIRY_TIME=<ISO timestamp, ~1 hour out>
#
# ---------------------------------------------------------------------------
# Set by scripts/kbench-env.sh, because `b auth` does not write them:
#
#   LLM_DEFAULT        model used by kbench.llm for local runs
#   LLM_DEFAULT_JUDGE  model used by kbench.judge_llm
#   LLMS_AVAILABLE     comma-separated models exposed via kbench.llms
#
# The local staging proxy serves a fixed set of 12 models, provider-prefixed.
# List them with:
#
#   curl -s -H "Authorization: Bearer $MODEL_PROXY_API_KEY" "$MODEL_PROXY_URL"
#
# ---------------------------------------------------------------------------
# Corpus. Build-time only; nothing here runs on Kaggle.

CORPUS_REPO_PATH=/home/digitamo/workspace/playground/dlt
TARGET_REPO_URL=https://github.com/dlt-hub/dlt.git
TARGET_REPO_COMMIT=ff414a0a4abbae8413678ff0da6fc66533236cc9
